[Unit]
Description=Enterprise Operations Platform (Sales, Stock & Reverse Logistics)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/enterprise-ops
Environment="PATH=/opt/enterprise-ops/.venv/bin:/usr/local/bin:/usr/bin"
Environment="ENVIRONMENT=production"
Environment="PORT=8000"
Environment="DATABASE_URL=sqlite:////opt/enterprise-ops/data/app.db"
ExecStart=/opt/enterprise-ops/.venv/bin/uvicorn backend.app.main:app --host 127.0.0.1 --port 8000 --workers 2

Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
