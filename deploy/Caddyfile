# Production Caddyfile for Automated Let's Encrypt HTTPS
# Replace ops.yourdomain.com with your live domain or server public IP

ops.yourdomain.com {
    reverse_proxy localhost:8000 {
        header_up Host {host}
        header_up X-Real-IP {remote}
        header_up X-Forwarded-For {remote}
        header_up X-Forwarded-Proto {scheme}
    }

    # Compression for low-latency mobile networks
    encode zstd gzip

    # Production security headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    log {
        output file /var/log/caddy/enterprise-ops.log {
            roll_size 10mb
            roll_keep 5
        }
    }
}
